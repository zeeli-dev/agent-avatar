{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Docs site: static assets only, no Worker script.
  "name": "agent-avatar-docs",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "avatars.zeeli.dev", "custom_domain": true }],
  "workers_dev": false
}
