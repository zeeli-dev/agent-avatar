{
  "name": "@zeeli/avatars",
  "version": "0.5.0",
  "description": "Cute animated avatars for AI agents. One zero-dependency web component, 24 characters, four states.",
  "keywords": [
    "avatar",
    "ai-agents",
    "web-component",
    "custom-element",
    "animation",
    "svg",
    "react",
    "status",
    "mascot"
  ],
  "homepage": "https://avatars.zeeli.dev",
  "bugs": {
    "url": "https://github.com/zeeli-dev/avatars/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeli-dev/avatars.git"
  },
  "license": "MIT",
  "author": "Manno Beats",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/element.js"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tests/types",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "size": "node scripts/size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm size && pnpm test:browser",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "pnpm build:site && wrangler deploy",
    "media": "node scripts/media.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "peerDependencies": {
    "@types/react": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "4.141.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
